#!/usr/bin/env bash
# Swift toolchain lldb (has Swift plugin + remote-ios platform). It links libpython3.12,
# which Arch doesn't ship; borrow it from a uv-managed CPython 3.12.
set -euo pipefail
py=$(uv python find 3.12 2>/dev/null) || { uv python install 3.12 >&2 && py=$(uv python find 3.12); }
home=$(dirname "$(dirname "$(readlink -f "$py")")")
export LD_LIBRARY_PATH="$home/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PYTHONHOME="$home"
exec /usr/lib/swift/usr/bin/lldb "$@"
