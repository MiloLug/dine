[Unit]
Description=pymobiledevice3 tunneld (iOS 17+ RemoteXPC tunnel for developer services / debugserver)
After=usbmuxd-bridge.service
Requires=usbmuxd-bridge.service

[Service]
# Runs as root from the user's .venv (uv sync); don't leave root-owned __pycache__ there, or
# the next `uv sync` can't replace those packages.
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@DINE_ROOT@/.venv/bin/pymobiledevice3 remote tunneld
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
