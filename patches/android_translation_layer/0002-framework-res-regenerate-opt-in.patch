diff --git a/meson_options.txt b/meson_options.txt
new file mode 100644
index 00000000..e771f926
--- /dev/null
+++ b/meson_options.txt
@@ -0,0 +1,2 @@
+option('regenerate_framework_res', type: 'boolean', value: false,
+       description: 'Rebuild framework-res.apk with aapt. Rewrites src/api-impl/com/android/internal/{R,Manifest}.java')
diff --git a/res/framework-res/meson.build b/res/framework-res/meson.build
index b487b11b..45aff8d9 100644
--- a/res/framework-res/meson.build
+++ b/res/framework-res/meson.build
@@ -1,6 +1,7 @@
-aapt = find_program('aapt', required: false)
-
-if aapt.found()
+# Opt-in: regenerating rewrites the committed R.java/Manifest.java, and any aapt on PATH (e.g. the
+# one from android-sdk-build-tools) produces different resource IDs than the committed ones.
+if get_option('regenerate_framework_res')
+  aapt = find_program('aapt')
   aapt_command = [aapt, 'package', '-x', '-f', '--custom-package', 'com.android.internal', '-S', join_paths(dir_base, 'res/framework-res/res'), '-A', join_paths(dir_base, 'res/framework-res/assets'), '-M', join_paths(dir_base, 'res/framework-res/AndroidManifest.xml'), '-J', join_paths(dir_base, 'src/api-impl/com/android/internal'), '-F', '@OUTPUT@']
 else  # fallback to prebuilt APK
   aapt_command = ['cp', join_paths(dir_base, 'res/framework-res/framework-res.apk'), '@OUTPUT@']
